<div class="my-cv">
  <style>
    .my-cv *, .my-cv *::before, .my-cv *::after { box-sizing: border-box; margin: 0; padding: 0; }

    .my-cv {
      font-family: 'DM Sans', sans-serif;
      font-weight: 500;
      font-size: 14px;
      color: #111;
      background: #fff;
      max-width: 780px;
      margin: 48px auto;
      padding: 0 32px 64px;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    .my-cv .cv-header { border-bottom: 0.5px solid #ccc; padding-bottom: 1.5rem; margin-bottom: 1.5rem; }
    .my-cv .cv-name { font-family: 'Playfair Display', serif; font-size: 34px; font-weight: 500; letter-spacing: -0.5px; margin-bottom: 6px; color: #000; }
    .my-cv .cv-contact { display: flex; gap: 20px; flex-wrap: wrap; margin-top: 8px; }
    .my-cv .cv-contact a { font-size: 13px; color: #111; font-weight: 600; text-decoration: none; }
    .my-cv .cv-contact a:hover { text-decoration: underline; }
    .my-cv .cv-summary { font-size: 13.5px; color: #111; line-height: 1.7; margin-top: 12px; max-width: 640px; font-weight: 500; }

    .my-cv .section { margin-bottom: 2rem; }
    .my-cv .section-title { font-size: 10.5px; font-weight: 600; letter-spacing: 1.6px; text-transform: uppercase; color: #444; margin-bottom: 12px; padding-bottom: 6px; border-bottom: 0.5px solid #ccc; }

    .my-cv .skills-row { display: flex; flex-direction: column; gap: 6px; }
    .my-cv .skill-line { display: flex; font-size: 13px; gap: 8px; }
    .my-cv .skill-label { color: #333; font-weight: 600; min-width: 190px; flex-shrink: 0; }
    .my-cv .skill-val { color: #111; font-weight: 500; }

    .my-cv .job { margin-bottom: 1.5rem; }
    .my-cv .job-header { display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 4px; margin-bottom: 4px; }
    .my-cv .job-title { font-size: 14.5px; font-weight: 600; color: #000; }
    .my-cv .job-meta { font-size: 12.5px; color: #333; margin-top: 2px; font-weight: 500; }
    .my-cv .job-date { font-size: 12px; color: #333; white-space: nowrap; font-weight: 500; }
    .my-cv .job-bullets { list-style: none; margin-top: 8px; }
    .my-cv .job-bullets li { font-size: 13px; color: #111; line-height: 1.65; padding: 2px 0 2px 16px; position: relative; font-weight: 500; }
    .my-cv .job-bullets li::before { content: '–'; position: absolute; left: 0; color: #666; }

    .my-cv .edu-row { display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 4px; }
    .my-cv .edu-title { font-size: 14.5px; font-weight: 600; color: #000; }
    .my-cv .edu-sub { font-size: 13px; color: #333; margin-top: 2px; font-weight: 500; }
    .my-cv .edu-date { font-size: 12px; color: #333; white-space: nowrap; font-weight: 500; }

    .my-cv .award-item { font-size: 13px; color: #111; font-weight: 500; padding: 4px 0; display: flex; align-items: center; gap: 8px; }
    .my-cv .award-item::before { content: '★'; font-size: 10px; color: #555; }
  </style>

  <%= stylesheet_link_tag "https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500&family=DM+Sans:wght@500;600&display=swap" %>

  <div class="cv-header">
    <h1 class="cv-name">Fakhriddin Makhmadiyorov</h1>
    <div class="cv-contact">
      <a href="mailto:makhmadiyorovfakhriddindaad@gmail.com">makhmadiyorovfakhriddindaad@gmail.com</a>
