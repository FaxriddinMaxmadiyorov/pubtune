<div class="card-dark p-4">
  <h6 class="mb-3" style="font-weight: 700;">
    <i class="bi bi-terminal me-2" style="color: var(--accent)"></i>Ulash
  </h6>

  <p style="color: var(--text-muted); font-size: 0.88rem; margin-bottom: 1rem;">
    Quyidagi buyruqni local mashinangizda ishga tushiring:
  </p>

  <div class="code-block">
    <div class="code-block-header">
      <span>Terminal</span>
      <button class="btn-icon" onclick="copyText('ruby pubtune_client.rb --token <%= @tunnel.token %> --port <%= @tunnel.local_port %>')">
        <i class="bi bi-copy"></i>
      </button>
    </div>
    <pre class="code-block-content">ruby pubtune_client.rb \
  --token <%= @tunnel.token %> \
  --port <%= @tunnel.local_port %></pre>
  </div>

  <div class="mt-3">
    <a href="/pubtune_client.rb" class="btn btn-accent btn-sm">
      <i class="bi bi-download me-1"></i>Client yuklab olish
    </a>
  </div>
</div>

<% content_for :scripts do %>
<script>
  function copyText(text) {
    navigator.clipboard.writeText(text);
  }

  let tokenVisible = false;
  function toggleToken(token) {
    const span = document.getElementById('tokenText');
    const eye  = document.getElementById('tokenEye');
    tokenVisible = !tokenVisible;
    span.textContent = tokenVisible ? token : '••••••••••••••••';
    eye.className = tokenVisible ? 'bi bi-eye-slash' : 'bi bi-eye';
  }
</script>
<% end %>
