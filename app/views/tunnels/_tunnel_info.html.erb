<div class="card-dark p-4">
  <div class="d-flex align-items-center justify-content-between mb-4">
    <h5 class="page-title mb-0"><%= @tunnel.name %></h5>
    <% if @tunnel.active? %>
      <span class="status-badge status-active">
        <span class="status-dot"></span>Aktiv
      </span>
    <% else %>
      <span class="status-badge status-inactive">Nofaol</span>
    <% end %>
  </div>

  <div class="tunnel-info-grid">
    <div class="tunnel-info-item">
      <div class="tunnel-info-label">Public URL</div>
      <div class="tunnel-info-value">
        <span class="tunnel-url"><%= @tunnel.subdomain %>.mfakhriddin.uz</span>
        <button class="btn-icon ms-2" onclick="copyText('<%= @tunnel.subdomain %>.mfakhriddin.uz')">
          <i class="bi bi-copy"></i>
        </button>
      </div>
    </div>

    <div class="tunnel-info-item">
      <div class="tunnel-info-label">Local port</div>
      <div class="tunnel-info-value mono">localhost:<%= @tunnel.local_port %></div>
    </div>

    <div class="tunnel-info-item">
      <div class="tunnel-info-label">Token</div>
      <div class="tunnel-info-value mono">
        <span id="tokenText">••••••••••••••••</span>
        <button class="btn-icon ms-2" onclick="toggleToken('<%= @tunnel.token %>')">
          <i class="bi bi-eye" id="tokenEye"></i>
        </button>
        <button class="btn-icon ms-1" onclick="copyText('<%= @tunnel.token %>')">
          <i class="bi bi-copy"></i>
        </button>
      </div>
    </div>

    <div class="tunnel-info-item">
      <div class="tunnel-info-label">Yaratilgan</div>
      <div class="tunnel-info-value"><%= @tunnel.created_at.strftime("%d.%m.%Y %H:%M") %></div>
    </div>
  </div>

  <div class="mt-4 d-flex gap-2">
    <%= link_to root_path, class: "btn btn-sm", style: "background: var(--bg-hover); color: var(--text-muted); border: 1px solid var(--border);" do %>
      <i class="bi bi-arrow-left me-1"></i>Orqaga
    <% end %>
    <%= link_to tunnel_path(@tunnel),
        data: { turbo_method: :delete, turbo_confirm: "O'chirishni tasdiqlaysizmi?" },
        class: "btn btn-sm",
        style: "background: #ff4d4d22; color: #ff4d4d; border: 1px solid #ff4d4d44;" do %>
      <i class="bi bi-trash me-1"></i>O'chirish
    <% end %>
  </div>
</div>
