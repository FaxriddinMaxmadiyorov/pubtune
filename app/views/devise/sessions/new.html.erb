<div class="auth-wrapper">
  <div class="auth-container">

    <div class="text-center mb-4">
      <div class="auth-logo">Pubtune</div>
      <p class="auth-subtitle">Tizimga kirish</p>
    </div>

    <div class="card-dark p-4">
      <h5 class="auth-title mb-4">
        <i class="bi bi-door-open me-2"></i>Kirish
      </h5>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>

        <div class="mb-3">
          <%= f.label :email, "Email", class: "auth-label" %>
          <div class="input-group">
            <span class="input-group-text auth-input-addon">
              <i class="bi bi-envelope"></i>
            </span>
            <%= f.email_field :email, autofocus: true, autocomplete: "email",
                class: "form-control auth-input", placeholder: "email@example.com" %>
          </div>
        </div>

        <div class="mb-3">
          <%= f.label :password, "Parol", class: "auth-label" %>
          <div class="input-group">
            <span class="input-group-text auth-input-addon">
              <i class="bi bi-lock"></i>
            </span>
            <%= f.password_field :password, autocomplete: "current-password",
                class: "form-control auth-input", placeholder: "••••••••", id: "passwordField" %>
            <button class="input-group-text auth-input-addon auth-eye-btn" type="button" onclick="togglePassword('passwordField', 'eyeIcon')">
              <i class="bi bi-eye" id="eyeIcon"></i>
            </button>
          </div>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="mb-3 d-flex align-items-center gap-2">
            <%= f.check_box :remember_me, class: "form-check-input auth-checkbox" %>
            <%= f.label :remember_me, "Eslab qolish", class: "auth-remember-label" %>
          </div>
        <% end %>

        <%= f.submit "Kirish", class: "btn btn-accent w-100 py-2 mb-3" %>

      <% end %>

      <div class="auth-links">
        <% if devise_mapping.recoverable? && controller_name != 'passwords' %>
          <div class="text-center mb-2">
            <%= link_to "Parolni unutdingizmi?", new_password_path(resource_name), class: "auth-link-muted" %>
          </div>
        <% end %>
        <% if devise_mapping.registerable? && controller_name != 'registrations' %>
          <div class="text-center auth-switch">
            Hisob yo'qmi?
            <%= link_to "Ro'yxatdan o'tish", new_registration_path(resource_name), class: "auth-link-accent" %>
          </div>
        <% end %>
      </div>
    </div>

  </div>
</div>
