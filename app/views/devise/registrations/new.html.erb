<div class="auth-wrapper">
  <div class="auth-container">

    <div class="text-center mb-4">
      <div class="auth-logo">Pubtune</div>
      <p class="auth-subtitle">Hisob yaratish</p>
    </div>

    <div class="card-dark p-4">
      <h5 class="auth-title mb-4">
        <i class="bi bi-person-plus me-2"></i>Ro'yxatdan o'tish
      </h5>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>

        <%= render "devise/shared/error_messages", resource: resource %>

        <div class="mb-3">
          <%= f.label :email, "Email", class: "auth-label" %>
          <div class="input-group">
            <span class="input-group-text auth-input-addon">
              <i class="bi bi-envelope"></i>
            </span>
            <%= f.email_field :email, autofocus: true, autocomplete: "email",
                class: "form-control auth-input", placeholder: "email@example.com" %>
          </div>
        </div>

        <div class="mb-3">
          <%= f.label :password, "Parol", class: "auth-label" %>
          <% if @minimum_password_length %>
            <small class="auth-hint"><%= @minimum_password_length %> ta belgidan ko'p</small>
          <% end %>
          <div class="input-group">
            <span class="input-group-text auth-input-addon">
              <i class="bi bi-lock"></i>
            </span>
            <%= f.password_field :password, autocomplete: "new-password",
                class: "form-control auth-input", placeholder: "••••••••", id: "passField" %>
            <button class="input-group-text auth-input-addon auth-eye-btn" type="button" onclick="togglePassword('passField', 'eyePass')">
              <i class="bi bi-eye" id="eyePass"></i>
            </button>
          </div>
        </div>

        <div class="mb-4">
          <%= f.label :password_confirmation, "Parolni tasdiqlang", class: "auth-label" %>
          <div class="input-group">
            <span class="input-group-text auth-input-addon">
              <i class="bi bi-shield-lock"></i>
            </span>
            <%= f.password_field :password_confirmation, autocomplete: "new-password",
                class: "form-control auth-input", placeholder: "••••••••", id: "passConfField" %>
            <button class="input-group-text auth-input-addon auth-eye-btn" type="button" onclick="togglePassword('passConfField', 'eyeConf')">
              <i class="bi bi-eye" id="eyeConf"></i>
            </button>
          </div>
        </div>

        <%= f.submit "Hisob yaratish", class: "btn btn-accent w-100 py-2 mb-3" %>

      <% end %>

      <div class="auth-links">
        <div class="text-center auth-switch">
          Hisobingiz bormi?
          <%= link_to "Kirish", new_session_path(resource_name), class: "auth-link-accent" %>
        </div>
      </div>
    </div>

  </div>
</div>
