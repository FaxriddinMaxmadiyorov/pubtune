<nav class="navbar navbar-expand-lg sticky-top">
  <div class="container-fluid px-4">

    <a class="navbar-brand" href="<%= root_path %>">
      <i class="bi bi-broadcast me-1"></i>Pubtune
    </a>

    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
      <i class="bi bi-list text-white fs-5"></i>
    </button>

    <div class="collapse navbar-collapse" id="navbarContent">
      <ul class="navbar-nav me-auto gap-1 ms-3">
        <% if user_signed_in? %>
          <li class="nav-item">
            <%= link_to root_path, class: "nav-link #{controller_name == 'dashboard' ? 'active' : ''}" do %>
              <i class="bi bi-grid me-1"></i>Dashboard
            <% end %>
          </li>
          <li class="nav-item">
            <%= link_to tunnels_path, class: "nav-link #{controller_name == 'tunnels' ? 'active' : ''}" do %>
              <i class="bi bi-diagram-3 me-1"></i>Tunnellar
            <% end %>
          </li>
        <% end %>
      </ul>

      <div class="d-flex align-items-center gap-2">
        <% if user_signed_in? %>
          <div class="dropdown">
            <div class="user-avatar dropdown-toggle" data-bs-toggle="dropdown">
              <%= current_user.email[0].upcase %>
            </div>
            <ul class="dropdown-menu dropdown-menu-end">
              <li>
                <div class="dropdown-header"><%= current_user.email %></div>
              </li>
              <li><hr class="dropdown-divider"></li>
              <li>
                <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "dropdown-item text-danger" do %>
                  <i class="bi bi-box-arrow-right me-2"></i>Chiqish
                <% end %>
              </li>
            </ul>
          </div>
        <% else %>
          <%= link_to "Kirish", new_user_session_path, class: "btn btn-outline-accent btn-sm" %>
